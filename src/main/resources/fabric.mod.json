{
  "schemaVersion": 1,
  "id": "dungeonscontent",
  "version": "${version}",
  "name": "Dungeons Content",
  "description": "Minecraft Dungeons 1 content brought to Minecraft",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/dungeonscontent/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "me.kiiya.dcontent.client.DungeonsContentDataGenerator"
    ],
    "client": [
      "me.kiiya.dcontent.client.DungeonsContentClient"
    ],
    "main": [
      "me.kiiya.dcontent.DungeonsContent"
    ]
  },
  "mixins": [
    "dungeonscontent.mixins.json",
    {
      "config": "dungeonscontent.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
